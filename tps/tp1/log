import importlib.metadata as md, os, datetime

rows = []
for d in md.distributions():
    t = datetime.datetime.fromtimestamp(os.path.getmtime(d._path))
    rows.append((t, d.metadata["Name"], d.version))
for t, name, ver in sorted(rows):
    print(f"{t:%Y-%m-%d %H:%M}  {name}=={ver}")
